<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mint_ros</name>
  <version>1.0.0</version>
  <description>MINT Protocol integration for ROS 2 - Earn MINT tokens for robot work</description>
  
  <maintainer email="forge@foundrynet.io">FoundryNet</maintainer>
  <license>MIT</license>
  
  <url type="website">https://github.com/foundrynet</url>
  <url type="repository">https://github.com/foundrynet/mint-ros</url>
  
  <author email="forge@foundrynet.io">FoundryNet</author>

  <buildtool_depend>ament_python</buildtool_depend>
  
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
